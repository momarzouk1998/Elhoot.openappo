# ========================================
# ELHOOT — Environment Variables
# Copy to .env and fill in real values
# ========================================

# PostgreSQL — connects to the shared DO Postgres, schema=elhoot
DATABASE_URL=postgresql://elhoot:Elhoot2026!Secure@localhost:5432/elhoot_db

# JWT secret (CHANGE in production!)
JWT_SECRET=change-this-to-a-random-32-char-string-2026

# Public site URL
NEXT_PUBLIC_SITE_URL=https://elhoot.openappo.com

# App name
NEXT_PUBLIC_APP_NAME=شركة الحوت للأدوات الكهربائية
